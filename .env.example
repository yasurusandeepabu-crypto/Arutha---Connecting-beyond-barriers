CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
HOST=127.0.0.1
PORT=8000
# Optional. Set these in your shell; the demo does not auto-load .env files.
GLOSS_API_URL=
GLOSS_API_KEY=
GLOSS_MODEL=
WHISPER_MODEL=base.en
# Legacy SLSL research option only. Active HTTP routes use local ASL word matching.
TRANSLATION_ANALYZER=rules
